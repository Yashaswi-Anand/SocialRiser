# SocialRiser — static export served by Apache/LiteSpeed (Hostinger).
# This file is copied into out/ at build time; upload it alongside the site.

Options -Indexes

# Next.js writes a styled 404 page during export.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host is the apex, matching site.url in lib/site.ts.
  # Remove this block if you'd rather standardise on www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Build assets are content-hashed, so they can be cached indefinitely.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML and metadata must revalidate, or edits won't reach returning visitors.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Images and icons change occasionally — cache for a week, not a year.
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
